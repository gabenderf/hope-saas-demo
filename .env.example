# Copie para .env.local e ajuste. .env.local nunca vai para o git.

# De onde vêm os dados:
#   demo     = dados de exemplo gerados no navegador (padrão, não toca o banco)
#   supabase = dados reais, SOMENTE LEITURA nesta fase (nenhuma gravação é feita)
VITE_DATA_SOURCE=demo

# Como o login funciona:
#   demo     = escolher um perfil de demonstração, sem senha (bloqueado em build de produção)
#   supabase = Supabase Auth (e-mail + senha + MFA). Exige a migração descrita em docs/seguranca.md
VITE_AUTH_MODE=demo

# Só necessários quando algum dos modos acima for "supabase".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Liberar o modo demo num build de produção (ex.: um ambiente público de demonstração).
# Nunca ligar no ambiente com dados reais.
VITE_ALLOW_DEMO_IN_PRODUCTION=false

# Cloudflare Turnstile (CAPTCHA do login e da recuperação de senha). Só a chave PÚBLICA do site;
# a secreta fica no Supabase (Authentication > Bot and Abuse Protection). Vazio = sem CAPTCHA,
# aceitável só fora de produção. Ver docs/seguranca.md, seção 7.1.
VITE_TURNSTILE_SITE_KEY=
